---
import Layout from "../layouts/Layout.astro";
import PressCard from "@/components/PressCard.astro";
import SmallCard from "@/components/SmallCard.astro";
---

<Layout
  title="Marvin Kaunda | Product Engineer"
  description="Freelance Full Stack Developer & Product Designer specializing in AI-powered solutions, user-centered design, and scalable applications."
  image="/profile-picture.webp">
  <div class="min-h-screen px-6 py-6 grid grid-flow-row gap-4 lg:h-screen lg:min-h-0 lg:grid-cols-7 lg:overflow-hidden">
    <div class="flex min-h-0 flex-col gap-4 lg:col-span-5">
      <div
        class="relative h-96 shrink-0 overflow-hidden rounded-3xl bg-cover bg-top lg:h-auto lg:min-h-[280px] lg:flex-1"
        style="background-image: url('/profile-picture.webp');">
        <!-- Image div with gradient background -->
        <div
          class="absolute w-full h-full inset-0 bg-gradient-to-br from-black/20 via-black/10 to-black/30 z-0">
        </div>
        <!-- Linear gradient overlay -->
        <div
          class="absolute inset-x-0 bottom-0 left-0 h-60 bg-gradient-to-t from-black/50 to-transparent z-10">
        </div>
        <!-- Main heading -->
        <div
          class="absolute inset-x-5 bottom-5 z-20">
          <h1 class="text-white text-2xl sm:text-7xl font-semibold mb-2">
            <span class="animate-fade-in inline-block" style="animation-delay: 0ms;">M</span><span class="animate-fade-in inline-block" style="animation-delay: 40ms;">a</span><span class="animate-fade-in inline-block" style="animation-delay: 80ms;">r</span><span class="animate-fade-in inline-block" style="animation-delay: 120ms;">v</span><span class="animate-fade-in inline-block" style="animation-delay: 160ms;">i</span><span class="animate-fade-in inline-block" style="animation-delay: 200ms; margin-right: 0.25em;">n</span><span class="animate-fade-in inline-block" style="animation-delay: 240ms;">K</span><span class="animate-fade-in inline-block" style="animation-delay: 280ms;">a</span><span class="animate-fade-in inline-block" style="animation-delay: 320ms;">u</span><span class="animate-fade-in inline-block" style="animation-delay: 360ms;">n</span><span class="animate-fade-in inline-block" style="animation-delay: 400ms;">d</span><span class="animate-fade-in inline-block" style="animation-delay: 440ms;">a</span>
          </h1>
          <p
            class="max-w-[calc(100%_-_10rem)] text-sm font-light text-white/80 sm:max-w-none sm:text-xl">
            <span class="animate-fade-in inline-block" style="animation-delay: 480ms;">Founder &amp; CEO @</span>
            <a
              href="https://better-design.com"
              target="_blank"
              rel="noopener noreferrer"
              class="animate-fade-in inline-block text-white underline decoration-white/60 underline-offset-4 transition-colors hover:text-white/80 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
              style="animation-delay: 560ms;">Better Design</a>
          </p>
        </div>
      <!-- Contact CTA -->
      <div
        class="flex flex-row items-center gap-2 absolute right-0 bottom-0 pl-5 py-1 bg-background rounded-tl-2xl z-30">
        <!-- Border mask -->
        <svg
          class="absolute bottom-0 -left-6 h-6 w-6 fill-background"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M24 24V0C24 13.2549 13.2549 24 0 24H24Z"></path>
        </svg>
        <svg
          class="absolute right-0 -top-6 h-6 w-6 fill-background"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M24 24V0C24 13.2549 13.2549 24 0 24H24Z"></path>
        </svg>
        <!-- GitHub icon -->
        <a
          href="https://github.com/marvkr"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="h-11 w-11 p-2.5 relative rounded-full border border-border overflow-hidden hover:bg-foreground/10 hover:border-white/30 ease-in duration-100 animate-fade-in"
          style="animation-delay: 240ms;">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-full fill-foreground"
            viewBox="0 0 32 32"
            ><title>github</title><g fill="currentColor"
              ><path
                d="M16,2.345c7.735,0,14,6.265,14,14-.002,6.015-3.839,11.359-9.537,13.282-.7,.14-.963-.298-.963-.665,0-.473,.018-1.978,.018-3.85,0-1.312-.437-2.152-.945-2.59,3.115-.35,6.388-1.54,6.388-6.912,0-1.54-.543-2.783-1.435-3.762,.14-.35,.63-1.785-.14-3.71,0,0-1.173-.385-3.85,1.435-1.12-.315-2.31-.472-3.5-.472s-2.38,.157-3.5,.472c-2.677-1.802-3.85-1.435-3.85-1.435-.77,1.925-.28,3.36-.14,3.71-.892,.98-1.435,2.24-1.435,3.762,0,5.355,3.255,6.563,6.37,6.913-.403,.35-.77,.963-.893,1.872-.805,.368-2.818,.963-4.077-1.155-.263-.42-1.05-1.452-2.152-1.435-1.173,.018-.472,.665,.017,.927,.595,.332,1.277,1.575,1.435,1.978,.28,.787,1.19,2.293,4.707,1.645,0,1.173,.018,2.275,.018,2.607,0,.368-.263,.787-.963,.665-5.719-1.904-9.576-7.255-9.573-13.283,0-7.735,6.265-14,14-14Z"
              ></path></g
            ></svg
          >
        </a>
        <!-- LinkedIn icon -->
        <a
          href="https://www.linkedin.com/in/marvinkaunda"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          class="h-11 w-11 p-2.5 relative rounded-full border border-border overflow-hidden hover:bg-foreground/10 hover:border-white/30 ease-in duration-100 animate-fade-in"
          style="animation-delay: 320ms;">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-full fill-foreground"
            viewBox="0 0 32 32"
            ><title>linkedin</title><g fill="currentColor"
              ><path
                d="M26.111,3H5.889c-1.595,0-2.889,1.293-2.889,2.889V26.111c0,1.595,1.293,2.889,2.889,2.889H26.111c1.595,0,2.889-1.293,2.889-2.889V5.889c0-1.595-1.293-2.889-2.889-2.889ZM10.861,25.389h-3.877V12.87h3.877v12.519Zm-1.957-14.158c-1.267,0-2.293-1.034-2.293-2.31s1.026-2.31,2.293-2.31,2.292,1.034,2.292,2.31-1.026,2.31-2.292,2.31Zm16.485,14.158h-3.858v-6.571c0-1.802-.685-2.809-2.111-2.809-1.551,0-2.362,1.048-2.362,2.809v6.571h-3.718V12.87h3.718v1.686s1.118-2.069,3.775-2.069,4.556,1.621,4.556,4.975v7.926Z"
                fill-rule="evenodd"></path></g
            ></svg
          >
        </a>
        <!-- Email icon -->
        <a
          href="mailto:marvinkr@icloud.com"
          aria-label="Email Marvin"
          class="h-11 w-11 p-2.5 relative rounded-full border border-border overflow-hidden hover:bg-foreground/10 hover:border-white/30 ease-in duration-100 animate-fade-in"
          style="animation-delay: 400ms;">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-full h-full fill-foreground"
            viewBox="0 0 32 32"
            ><title>envelope</title><g fill="currentColor"
              ><path
                d="m16,14.882l15-7.5v-.382c0-2.206-1.794-4-4-4H5c-2.206,0-4,1.794-4,4v.382l15,7.5Z"
                fill="currentColor"
                stroke-width="0"></path><path
                d="m16,17.118L1,9.618v15.382c0,2.206,1.794,4,4,4h22c2.206,0,4-1.794,4-4v-15.382l-15,7.5Z"
                stroke-width="0"
                fill="currentColor"></path></g
            ></svg
          >
        </a>
      </div>
      </div>
      <div class="lg:hidden">
        <PressCard
          titleId="press-card-title-mobile"
          animationDelay="800ms"
        />
      </div>
      <section
        aria-label="About Marvin"
        class="about-section relative flex min-h-0 shrink flex-col overflow-hidden rounded-3xl border border-border bg-cover bg-scroll"
        style="background-image: var(--menu-background-image);">
        <div class="h-full min-h-0 p-4">
          <div
            class="h-full min-h-0 overflow-auto rounded-xl border border-border/50 bg-background/80 p-5 backdrop-blur-xs lg:overscroll-contain">
            <div>
              <p
                class="about-copy font-sans text-base leading-relaxed text-foreground">
                <span class="animate-fade-in inline-block" style="animation-delay: 0ms;">My fascination with technology started early. 👶🏾</span>
                <br /><br />
                <span class="animate-fade-in inline-block" style="animation-delay: 80ms;">Watching my dad pop floppy disks into his computer 💾, and me trying to imitate him</span>
                <span> </span>
                <span class="animate-fade-in inline-block" style="animation-delay: 160ms;">(often with plastic cards 💳), until he locked the drive to stop my early "experiments".</span>
                <br /><br />
                <span class="animate-fade-in inline-block" style="animation-delay: 240ms;">Since then, I've turned that curiosity into building things that worked better than my early experiments:</span>
                <br /><br />
                <span class="animate-fade-in inline-block" style="animation-delay: 320ms;">1. Started with a master's thesis that became a business,</span>
                <span> </span>
                <span class="animate-fade-in inline-block" style="animation-delay: 400ms;"><a href="https://owaste.webflow.io" target="_blank" class="text-yellow-500 underline decoration-dotted hover:text-yellow-400">helping men try sustainable living</a>. 🌱</span>
                <br />
                <span class="animate-fade-in inline-block" style="animation-delay: 480ms;">2. a <a href="https://cocktailanddinner.webflow.io" target="_blank" class="text-yellow-500 underline decoration-dotted hover:text-yellow-400">marketplace</a> to tackle loneliness and bring people together</span>
                <span> </span>
                <span class="animate-fade-in inline-block" style="animation-delay: 560ms;">for private dinners. 🍽️</span>
                <br />
                <span class="animate-fade-in inline-block" style="animation-delay: 640ms;">3. an <a href="https://web.archive.org/web/20250906221019/https://procureezy.com/" target="_blank" class="text-yellow-500 underline decoration-dotted hover:text-yellow-400">AI search engine</a> for hardware engineers building rocket engines 🚀 & satellites. 🛰️</span>
                <br /><br />
                <span class="animate-fade-in inline-block" style="animation-delay: 720ms;">Whether it's marketplaces, SaaS, mobile apps or AI tools</span>
                <span> </span>
                <span class="animate-fade-in inline-block" style="animation-delay: 800ms;">I simply love creating products bold enough to make a difference</span>
                <span> </span>
                <span class="animate-fade-in inline-block" style="animation-delay: 880ms;">& designed to put users first.</span>
                <br /><br />
                <span class="animate-fade-in inline-block" style="animation-delay: 960ms;">Outside work, I speak 6 languages 🌍,</span>
                <span> </span>
                <span class="animate-fade-in inline-block" style="animation-delay: 1040ms;">love to make a good dinner 🍽️, geek out over design in both digital & physical form 🎨,</span>
                <span> </span>
                <span class="animate-fade-in inline-block" style="animation-delay: 1120ms;">and lastly ... stress over F1 🏎️.</span>
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
    <div
      class="grid min-h-0 gap-4 lg:col-span-2 lg:grid-rows-[minmax(0,1fr)_auto]">
      <div class="flex min-h-0">
        <SmallCard
          title="Experience"
          link="/experience"
          image="/images/experience.webp"
          animationDelay="1520ms"
          preserveImage
        />
      </div>
      <div class="hidden lg:block">
        <PressCard titleId="press-card-title-desktop" />
      </div>
    </div>
  </div>
</Layout>

<style>
  @media (min-width: 1024px) and (max-height: 800px) {
    .about-copy {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }

    .about-copy br + br {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .about-section .animate-fade-in {
      animation-delay: 1120ms !important;
    }
  }
</style>
